generator client {
  provider = "prisma-client-js"
  output   = "../generated/netherite"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_NETHERITE")
}

model ffa_users {
  id              Int     @id @default(autoincrement())
  uuid            String  @db.MediumText
  name            String  @db.MediumText
  dateCreated     BigInt
  last_online     BigInt
  kitData         String  @db.MediumText
  kills           Int
  deaths          Int
  killStreak      Int
  bestStreak      Int
  time            String  @db.MediumText
  weather         Boolean
  killsVisibility String  @db.MediumText
}
